      <aliases enabled='yes' />
      <column caption='Student Performance ' datatype='string' name='[Calculation_104427244506976256]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [academic_performance] &gt;= 2.5 THEN &quot;High&quot; &#13;&#10;ELSEIF [academic_performance] &lt; 2.5 THEN &quot;Low&quot; &#13;&#10;END' />
      </column>
      <column caption='Pre-bed time screen' datatype='real' name='[Calculation_1886726797390430208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[screen_time_before_sleep] / [daily_social_media_hours]' />
      </column>
      <column caption='Risk Category' datatype='string' name='[Calculation_1886726797391486977]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_1886726797390430208] &gt;= 0.5 THEN &quot;High Night-Time Concentration&quot;&#13;&#10;ELSEIF [Calculation_1886726797390430208] &gt;= 0.2 THEN &quot;Meduim Night-Time Concentration&quot;&#13;&#10;ELSE &quot;Low Night-Time Concentration&quot; END' />
      </column>
